# Example environment variables for Railway / production
# Copy this file to `.env` locally (do NOT commit secrets)

# MongoDB connection URI (Atlas recommended)
# e.g. mongodb+srv://user:pass@cluster0.mongodb.net/dbname
MONGODB_URI=your_mongodb_connection_string

# JWT secret used to sign tokens
JWT_SECRET=replace_with_a_strong_secret

# Frontend URL for CORS and links (set after deploying frontend)
FRONTEND_URL=https://your-frontend-url

# Email credentials for notifications (nodemailer)
EMAIL_USER=your_email_user@example.com
EMAIL_PASS=your_email_password

# Development toggles
USE_IN_MEMORY_DB=false
ALLOW_DEV_AUTH=false

# Node environment and port
NODE_ENV=production
PORT=3000
